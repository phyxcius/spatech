# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Required in production (NODE_ENV=production):
# JWT_SECRET must be at least 32 characters
JWT_SECRET=""
SUPERADMIN_PIN=""
WHATSAPP_VERIFY_TOKEN=""

# Optional: only needed if the Vite frontend is hosted separately from server.ts (e.g., GitHub Pages)
VITE_API_BASE_URL=""
FIREBASE_RTDB_URL="https://spatech-b3edf-default-rtdb.firebaseio.com"
VITE_FIREBASE_RTDB_URL="https://spatech-b3edf-default-rtdb.firebaseio.com"

# Avatar Humanoide Realista (HeyGen Interactive Avatar vía WebRTC proxy en servidor)
HEYGEN_API_KEY=""
HEYGEN_AVATAR_ID="Wayne_20240711"
HEYGEN_VOICE_ID=""

